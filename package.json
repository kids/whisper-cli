{
  "name": "whisper-cli",
  "version": "1.0.0",
  "description": "Multi-platform IM -> AI CLI forwarding service (Feishu/WeCom/Telegram -> Codex/Claude/Gemini/Cursor/CodeBuddy)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:markers": "tsx scripts/marker_check.ts",
    "capture-chat-id": "tsx scripts/capture-chat-id.ts",
    "orc": "tsx src/orc/cli.ts"
  },
  "keywords": ["chatops", "feishu", "wecom", "telegram", "codebuddy", "cursor", "codex", "claude", "gemini", "ai-agent"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
