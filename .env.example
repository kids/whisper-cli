# =============================================================================
# whisper-cli 多组 IM -> AI CLI 转发服务配置
# =============================================================================
# 每组 agent 是一个独立的转发桥梁：IM 平台 ↔ AI CLI
# 按 AGENT_<N>_* 格式编号，所有组可同时启动
#
# 配置项说明:
#   AGENT_<N>_NAME         = 组名（日志标识）
#   AGENT_<N>_PLATFORM     = IM 平台: feishu | wecom
#   AGENT_<N>_AI_CLI       = AI 命令行:
#                            codebuddy | cursor | codex | claude | gemini
#                            别名: codex-cli, claude-code / claude-code-cli, gemini-cli
#   AGENT_<N>_<PLATFORM>_* = 该平台的凭证 (APP_ID, APP_SECRET 等)
#   AGENT_<N>_<CLI>_*      = 该 AI CLI 的凭证 (API_KEY 等)
#                            Codex / Claude / Gemini 可用各自的 login，无需 API Key
#   AGENT_<N>_ALLOWLIST    = 允许的用户 open_id，逗号分隔 (可选)
#
# 注意: 多组同时跑必须使用【不同】的飞书应用（不同 APP_ID），否则长连接会抢事件。
# =============================================================================

# -----------------------------------------------------------------------------
# Agent Group 1: Feishu ↔ CodeBuddy
# -----------------------------------------------------------------------------
AGENT_1_NAME=CodeBuddy Bot
AGENT_1_PLATFORM=feishu
AGENT_1_AI_CLI=codebuddy
AGENT_1_FEISHU_APP_ID=cli_xxxxxxxxxxxx
AGENT_1_FEISHU_APP_SECRET=xxxxxxxxxxxx
AGENT_1_FEISHU_ALLOWLIST=ou_xxxxxxxxxxxx
AGENT_1_CODEBUDDY_API_KEY=ck_xxxxxxxxxxxx
AGENT_1_CODEBUDDY_INTERNET_ENVIRONMENT=ioa

# -----------------------------------------------------------------------------
# Agent Group 2: Feishu ↔ Cursor（管理台模式 = feishu-cursor UX）
# -----------------------------------------------------------------------------
AGENT_2_NAME=Cursor Bot
AGENT_2_PLATFORM=feishu
AGENT_2_AI_CLI=cursor
# 管理台模式：私聊=/新任务/列表/归档，工作群=AI session（Cursor 默认开启）
AGENT_2_ADMIN_MODE=true
AGENT_2_FEISHU_APP_ID=cli_yyyyyyyyyyyy
AGENT_2_FEISHU_APP_SECRET=yyyyyyyyyyyy
AGENT_2_FEISHU_CHAT_ID=oc_xxxxxxxxxxxx
AGENT_2_CURSOR_API_KEY=crsr_xxxxxxxxxxxx
AGENT_2_WORKDIR=/path/to/project

# -----------------------------------------------------------------------------
# Agent Group 3: Feishu ↔ Codex (OpenAI)
# -----------------------------------------------------------------------------
# 无需 API Key — 先执行 `codex login` 登录 OpenAI / ChatGPT 账号
# AGENT_3_NAME=Codex Bot
# AGENT_3_PLATFORM=feishu
# AGENT_3_AI_CLI=codex
# AGENT_3_ADMIN_MODE=true
# AGENT_3_FEISHU_APP_ID=cli_xxxxxxxxxxxx
# AGENT_3_FEISHU_APP_SECRET=xxxxxxxxxxxx
# AGENT_3_WORKDIR=/path/to/project

# -----------------------------------------------------------------------------
# Agent Group 4: Feishu ↔ Claude Code
# -----------------------------------------------------------------------------
# 无需 API Key — 先执行 `claude /login`（Claude.ai 订阅，推荐）
# 可选: AGENT_4_ANTHROPIC_API_KEY=sk-ant-xxx  （走 API 按量付费，不推荐与订阅混用）
# AGENT_4_NAME=Claude Bot
# AGENT_4_PLATFORM=feishu
# AGENT_4_AI_CLI=claude
# AGENT_4_ADMIN_MODE=true
# AGENT_4_FEISHU_APP_ID=cli_xxxxxxxxxxxx
# AGENT_4_FEISHU_APP_SECRET=xxxxxxxxxxxx
# AGENT_4_WORKDIR=/path/to/project

# -----------------------------------------------------------------------------
# Agent Group 5: Feishu ↔ Gemini CLI
# -----------------------------------------------------------------------------
# 无需 API Key — 先交互运行一次 `gemini` 完成 OAuth
# 可选: AGENT_5_GEMINI_API_KEY=AIza...  或 AGENT_5_GOOGLE_API_KEY=...
# AGENT_5_NAME=Gemini Bot
# AGENT_5_PLATFORM=feishu
# AGENT_5_AI_CLI=gemini
# AGENT_5_ADMIN_MODE=true
# AGENT_5_FEISHU_APP_ID=cli_xxxxxxxxxxxx
# AGENT_5_FEISHU_APP_SECRET=xxxxxxxxxxxx
# AGENT_5_WORKDIR=/path/to/project

# -----------------------------------------------------------------------------
# Agent Group 6: WeCom (企微) ↔ CodeBuddy (示例)
# -----------------------------------------------------------------------------
# AGENT_6_NAME=WeCom CodeBuddy
# AGENT_6_PLATFORM=wecom
# AGENT_6_AI_CLI=codebuddy
# AGENT_6_WECOM_CORP_ID=wwxxxxxxxxxxxx
# AGENT_6_WECOM_CORP_SECRET=xxxxxxxxxxxx
# AGENT_6_WECOM_TOKEN=xxxxxxxxxxxx
# AGENT_6_WECOM_ENCODING_AES_KEY=xxxxxxxxxxxx
# AGENT_6_CODEBUDDY_API_KEY=ck_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 全局配置（可选）
# -----------------------------------------------------------------------------
# 工作目录（AI CLI 执行时的 cwd），默认 = 项目根目录
# WORKDIR=/Users/r/code/dev/whisper-cli

# CodeBuddy 可执行文件路径，留空则自动探测常见位置
#   macOS ARM:  /opt/homebrew/bin/codebuddy
#   macOS x64:  /usr/local/bin/codebuddy
#   Linux:      /usr/local/bin/codebuddy, /home/linuxbrew/.linuxbrew/bin/codebuddy, ~/.local/bin/codebuddy
# CODEBUDDY_BIN=/opt/homebrew/bin/codebuddy

# Cursor Agent 可执行文件路径, 留空则自动探测常见位置
#   macOS/Linux: ~/.local/bin/agent, /opt/homebrew/bin/agent, /usr/local/bin/agent
# CURSOR_AGENT_BIN=~/.local/bin/agent

# Codex 可执行文件路径, 留空则自动探测常见位置
#   macOS/Linux: ~/.local/bin/codex, /opt/homebrew/bin/codex, /usr/local/bin/codex
# CODEX_BIN=/root/.local/bin/codex

# Claude Code 可执行文件路径, 留空则自动探测
#   ~/.local/bin/claude, ~/.claude/local/claude, /opt/homebrew/bin/claude, /usr/local/bin/claude
# CLAUDE_BIN=/root/.local/bin/claude

# Gemini CLI 可执行文件路径, 留空则自动探测
#   ~/.local/bin/gemini, /opt/homebrew/bin/gemini, /usr/local/bin/gemini
# GEMINI_BIN=/root/.local/bin/gemini

# Agent 无输出超时（毫秒），默认 45 分钟；0 = 禁用
# AGENT_STALL_MS=2700000
# Agent 单轮总时长上限（毫秒），0 = 不限制
# AGENT_MAX_MS=0

# 日志级别: debug | info | warn | error
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# projects.json（工作区路由，与 AGENT_* 并列）
# -----------------------------------------------------------------------------
# 见项目根目录 projects.json：支持「项目名:指令」路由到不同 workspace
# 可选 systemPromptFile 为某项目注入系统提示
# 可选 addDirs 把额外目录挂给 Cursor / Claude / Gemini / Codex
